{
  "name": "story-search",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:up": "./scripts/dev-up.sh",
    "dev:down": "./scripts/dev-down.sh",
    "check:milvus": "npm run check:milvus -w @story-search/api",
    "ingest": "tsx packages/api/src/ingest.ts",
    "ingest:dry": "tsx packages/api/src/ingest.ts --dry-run",
    "api": "tsx packages/api/src/server.ts",
    "eval": "tsx packages/eval/runEval.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
